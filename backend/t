# WebhookService (local in-memory, no network)
# =============================================================
class TestWebhookService:
    def test_create_webhook(self):
        svc = WebhookService()
        webhook = asyncio.get_event_loop().run_until_complete(
            svc.create_webhook(1, "https://example.com/hook", ["user.created"])
        )
        assert webhook.id == 1
        assert webhook.url == "https://example.com/hook"

    def test_get_webhook_not_found(self):
        svc = WebhookService()
        assert asyncio.get_event_loop().run_until_complete(
            svc.get_webhook(999, 1)
        ) is None

    def test_get_webhook_wrong_user(self):
        svc = WebhookService()
        webhook = asyncio.get_event_loop().run_until_complete(
            svc.create_webhook(1, "https://example.com/hook", ["user.created"])
        )
        assert asyncio.get_event_loop().run_until_complete(
            svc.get_webhook(webhook.id, 2)
        ) is None

    def test_list_webhooks(self):
        svc = WebhookService()
        asyncio.get_event_loop().run_until_complete(
            svc.create_webhook(1, "https://example.com/hook", ["user.created"], description="Desc")
        )
        hooks = asyncio.get_event_loop().run_until_complete(svc.list_webhooks(1))
        assert len(hooks) == 1
        assert hooks[0].description == "Desc"

    def test_update_webhook(self):
        svc = WebhookService()
        webhook = asyncio.get_event_loop().run_until_complete(
            svc.create_webhook(1, "https://example.com/hook", ["user.created"])
        )
        updated = asyncio.get_event_loop().run_until_complete(
            svc.update_webhook(webhook.id, 1, url="https://new.example.com/hook")
        )
        assert updated.url == "https://new.example.com/hook"

    def test_delete_webhook(self):
        svc = WebhookService()
        webhook = asyncio.get_event_loop().run_until_complete(
            svc.create_webhook(1, "https://example.com/hook", ["user.created"])
        )
        deleted = asyncio.get_event_loop().run_until_complete(
            svc.delete_webhook(webhook.id, 1)
        )
        assert deleted is True
        assert asyncio.get_event_loop().run_until_complete(
            svc.get_webhook(webhook.id, 1)
        ) is None

    def test_delete_webhook_not_found(self):
        svc = WebhookService()
        assert asyncio.get_event_loop().run_until_complete(
            svc.delete_webhook(123, 1)
        ) is False

    def test_test_webhook_not_found(self):
        svc = WebhookService()
        result = asyncio.get_event_loop().run_until_complete(
            svc.test_webhook(123, 1)
        )
        assert result == {"success": False, "error": "Webhook not found"}

    def test_get_delivery_logs_empty(self):
        svc = WebhookService()
        assert asyncio.get_event_loop().run_until_complete(
            svc.get_delivery_logs(1, 1)
        ) == []

    def test_get_delivery_logs_wrong_user(self):
        svc = WebhookService()
        result = asyncio.get_event_loop().run_until_complete(
            svc.get_delivery_logs(123, 1)
        )
        assert result == []


