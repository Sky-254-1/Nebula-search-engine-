{
  "compilerOptions": {
    "target": "ES2020",
    "module": "ES2020",
    "moduleResolution": "bundler",
    "lib": ["ES2020", "DOM"],
    "outDir": "./dist",
    "rootDir": "./",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "types": ["@capacitor/core"]
  },
  "include": [
    "src/**/*.ts",
    "plugins/**/*.ts",
    "sync/**/*.ts",
    "capacitor.config.ts"
  ],
  "exclude": [
    "node_modules",
    "dist"
  ]
}
