{
	"appId": "com.nebula.search",
	"appName": "Nebula Search",
	"webDir": "../frontend/dist",
	"server": {
		"androidScheme": "https",
		"cleartext": true
	},
	"plugins": {
		"PushNotifications": {
			"presentationOptions": [
				"badge",
				"sound",
				"alert"
			]
		},
		"SplashScreen": {
			"launchAutoHide": true,
			"backgroundColor": "#0f0f1a"
		}
	},
	"packageClassList": [
		"SpeechRecognition",
		"AppPlugin",
		"CAPCameraPlugin",
		"ClipboardPlugin",
		"FilesystemPlugin",
		"CAPNetworkPlugin",
		"PreferencesPlugin",
		"PushNotificationsPlugin",
		"SharePlugin"
	]
}
